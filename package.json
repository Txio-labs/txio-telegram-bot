{
  "name": "txio-telegram-bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "TELEGRAM_BOT_TOKEN=test TELEGRAM_CHAT_ID=test TELEGRAM_WEBHOOK_SECRET=test GITHUB_WEBHOOK_SECRET=test PUBLIC_URL=http://localhost:3000 tsx --test test-security.ts"
  },
  "dependencies": {
    "@octokit/webhooks": "^13.6.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.31.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
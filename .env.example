# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Channel/chat id the bot posts to (bot must be an admin of the channel)
TELEGRAM_CHAT_ID=

# Shared secret configured on the GitHub webhook (Settings > Webhooks)
GITHUB_WEBHOOK_SECRET=

# Optional: GitHub token for merge-conflict detection on private repos.
# A fine-grained PAT or GitHub App installation token with pull_requests: read scope.
# Without this, merge-conflict alerts will not work for private repos and may fail
# due to rate limits on public repos (60 requests/hour for unauthenticated requests).
GITHUB_TOKEN=

# Public base URL this service is reachable at (e.g. your Render URL),
# used to register the Telegram webhook (new-member events, etc).
PUBLIC_URL=

# Optional: route pull request notifications to this chat (e.g. your personal
# DM chat id) instead of the group. Leave unset to keep them in the group.
PULL_REQUEST_CHAT_ID=

# Optional: forum topic (message_thread_id) each event type posts into.
# Leave unset to post to the group's General topic.
TOPIC_THREAD_ISSUES=
TOPIC_THREAD_CI=
TOPIC_THREAD_DEPLOYS=

# Optional
PORT=3000
GITHUB_WEBHOOK_PATH=/webhooks/github
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Channel/chat id the bot posts to (bot must be an admin of the channel)
TELEGRAM_CHAT_ID=

# Secret token to authenticate Telegram webhook requests (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# Shared secret configured on the GitHub webhook (Settings > Webhooks)
GITHUB_WEBHOOK_SECRET=

# Optional: GitHub token for merge-conflict detection on private repos.
# A fine-grained PAT or GitHub App installation token with pull_requests: read scope.
# Without this, merge-conflict alerts will not work for private repos and may fail
# due to rate limits on public repos (60 requests/hour for unauthenticated requests).
GITHUB_TOKEN=

# Public base URL this service is reachable at (e.g. your Render URL),
# used to register the Telegram webhook (new-member events, etc).
PUBLIC_URL=

# Optional: route pull request notifications to this chat (e.g. your personal
# DM chat id) instead of the group. Leave unset to keep them in the group.
PULL_REQUEST_CHAT_ID=

# Optional: route security alert (Dependabot alert) notifications to this chat
# (e.g. your personal DM chat id) instead of the group. Leave unset to keep
# them in the group.
SECURITY_ALERT_CHAT_ID=

# Optional: forum topic (message_thread_id) each event type posts into.
# Leave unset to post to the group's General topic.
TOPIC_THREAD_ISSUES=
TOPIC_THREAD_PULL_REQUESTS=
TOPIC_THREAD_CI=
TOPIC_THREAD_DEPLOYS=
TOPIC_THREAD_BRANCHES=
TOPIC_THREAD_SECURITY=

# Optional: configure where and how "pull request opened" notifications are delivered.
# PR_OPENED_CHANNEL: "main_chat" (default) | "topic_thread" | "dm"
# PR_OPENED_FORMAT: "markdown_summary" (default) | "plain_text" | "inline_buttons"
PR_OPENED_CHANNEL=
PR_OPENED_FORMAT=

# Optional: configure where and how "pull request closed" notifications are delivered.
# PR_CLOSED_CHANNEL: "main_chat" (default) | "topic_thread" | "dm"
# PR_CLOSED_FORMAT: "markdown_summary" (default) | "plain_text" | "inline_buttons"
PR_CLOSED_CHANNEL=
PR_CLOSED_FORMAT=

# Optional: configure where and how "security alert raised" (Dependabot alert)
# notifications are delivered.
# SECURITY_ALERT_CHANNEL: "main_chat" (default) | "topic_thread" | "dm"
# SECURITY_ALERT_FORMAT: "markdown_summary" (default) | "plain_text" | "inline_buttons"
SECURITY_ALERT_CHANNEL=
SECURITY_ALERT_FORMAT=

# Optional
PORT=3000
GITHUB_WEBHOOK_PATH=/webhooks/github
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Optional: path to a JSON file mapping repository full names to per-repo
# chat/topic overrides. See repo-routing.example.json for the expected shape.
# When set, events from mapped repos are routed to the specified chat/topic;
# unmapped repos fall back to the defaults (TELEGRAM_CHAT_ID + topic threads).
REPO_ROUTING_CONFIG_PATH=

# ── Stale reminders (scheduled digest) ─────────────────────────────────
# Optional: cron schedule for the daily digest of stale (no recent activity)
# open PRs and issues. Standard cron syntax; default: 09:00 UTC.
# An empty or invalid value disables the reminder (with a logged warning).
STALE_REMINDER_CRON=

# Optional: how many days without activity before an open PR/issue counts as
# stale and is included in the reminder. Default: 7.
STALE_THRESHOLD_DAYS=

# Optional: comma-separated list of repos to monitor for the stale reminder,
# e.g. "txio-labs/txio-backend,txio-labs/txio-cli". Only used when
# REPO_ROUTING_CONFIG_PATH is not set; otherwise the routing file's repo keys
# are monitored. GITHUB_TOKEN is strongly recommended to avoid rate limits
# when polling several repos.
STALE_REPO_NAMES=

# ── Weekly bus-factor report ──────────────────────────────────────────
# Optional: standard cron schedule; default: Monday at 09:00 UTC.
BUS_FACTOR_CRON=
# Defaults: 70% concentration, 5 commits, 30 recent commits.
BUS_FACTOR_THRESHOLD_PERCENT=
BUS_FACTOR_MIN_COMMITS=
BUS_FACTOR_RECENT_COMMITS=
# Maximum files shown per repository. Default: 5.
BUS_FACTOR_TOP_FILES=
